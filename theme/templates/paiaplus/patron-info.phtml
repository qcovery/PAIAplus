<?php
/**
 * Displays selected information from the account of the currently logged-in
 * patron (expiration date, patron status, account note).
 *
 * This partial is currently meant to be rendered as a notification-like box above or beyond the breadcrumbs.
 * However, the data is provided by the PatronInfo view helper, so this template can be
 * included anywhere with the following line:
 *
 *   <?=$this->render('paiaplus/patron-info.phtml')?>
 *
 * The information is currently only rendered inside the account area, where the user is usually logged in.
 */
?>
<?php $patronInfoTemplateDirs = ['myresearch', 'holds']; ?>
<?php if (in_array($this->layout()->templateDir ?? null, $patronInfoTemplateDirs, true)): ?>
  <?php
    $patronInfo = $this->PatronInfo();
    $expirationClass = $patronInfo->showExpirationDate()
        ? $patronInfo->getExpirationClass() : '';
    $status = $patronInfo->showStatus() ? $patronInfo->getStatus() : '';
    $note = $patronInfo->showNote() ? $patronInfo->getNote() : '';
  ?>
  <?php /* Only render the box if there is something to show -- a theme may give it a border. */ ?>
  <?php if (!empty($expirationClass) || !empty($note) || !empty($status)): ?>
<div class="patron-info hidden-print">
  <?php if (!empty($expirationClass)): ?>
    <div class="alert patron-expires <?=$this->escapeHtmlAttr($expirationClass)?>">
      <?=$this->transEsc('patron_account_expires')?>: <?=$this->escapeHtml($patronInfo->getExpirationDateFormatted())?>
    </div>
  <?php endif; ?>
  <?php /* The note is maintained by the library and may contain markup, so it is not escaped. */ ?>
  <?php if (!empty($note)): ?>
    <div class="patron-note alert alert-info">
      <?=$note?>
    </div>
  <?php endif; ?>
  <?php if (!empty($status)): ?>
    <div class="patron-status alert alert-danger">
      <?=$this->transEsc('hold_error_blocked_status_' . $status)?>
    </div>
  <?php endif; ?>
</div>
  <?php endif; ?>
<?php endif; ?>
